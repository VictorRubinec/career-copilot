# Configurações opcionais do Career Copilot (copie para .env e ajuste conforme necessário)

# Overrides de caminhos (úteis para múltiplos perfis ou isolamento de dados)
CAREER_COPILOT_PROFILE_PATH=
CAREER_COPILOT_DATA_DIR=
CAREER_COPILOT_CACHE_DIR=
CAREER_COPILOT_ATS_BOARDS_PATH=
CAREER_COPILOT_BROWSER_PROFILE_DIR=

# Nível de log direcionado estritamente para stderr (DEBUG, INFO, WARNING, ERROR)
CAREER_COPILOT_LOG_LEVEL=WARNING

# Opcional: aumenta o rate-limit da API do GitHub no coletor nacional (github_br)
GITHUB_TOKEN=

# Opcional: chave Gemini caso utilize create_gemini_committee_provider() na Banca das 7 Personas
GEMINI_API_KEY=
